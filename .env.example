# Copy to .env.local and fill in. Validated at boot by src/env.ts.
# For builds/CI without real secrets, set SKIP_ENV_VALIDATION=1.

# --- Core ---
DATABASE_URL=postgres://user:password@localhost:5432/sprintify
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# --- Email (SMTP, required) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Sprintify

# Sign-up gating is now a runtime admin control (Admin → Controls), not an env
# var — an admin toggles "invite only" mode at /admin/platform.

# --- Cloudflare Turnstile (captcha) ---
# In dev these may be omitted (test keys are used). Required in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Storage ---
# STORAGE_BACKEND=local (default) or s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=.storage
# Required only when STORAGE_BACKEND=s3:
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_ENDPOINT=

# --- AI provider secrets (required only to configure AI in the app) ---
# Encrypts provider API keys (OpenRouter/OpenAI/...) at rest with AES-256-GCM.
# Must be 32 bytes: 64 hex characters, base64 of 32 bytes, or a literal
# 32-character string. Generate with: openssl rand -base64 32
# WARNING: changing this value makes every stored provider key undecryptable —
# admins must re-enter their keys. Rotate deliberately.
AI_ENCRYPTION_KEY=

# --- Observability (Sentry, optional; no-op when unset) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Analytics (Umami, optional; no-op when unset) ---
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional custom script URL (defaults to UMAMI_HOST_URL/script.js, or Umami Cloud)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
# Optional comma-separated domains
NEXT_PUBLIC_UMAMI_DOMAINS=
# Optional analytics host for server events, pixels, and the default browser script
UMAMI_HOST_URL=
# Optional tracking pixel ID for non-JS / email open tracking (UUID generated from Umami Dashboard → Pixels)
# Example: fba6be18-1e62-4f4c-9e6a-c0b75cccb7ce
UMAMI_PIXEL_ID=
NEXT_PUBLIC_UMAMI_PIXEL_ID=

# --- Admin seed (scripts/seed-admin.ts, optional) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
