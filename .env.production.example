# Copy to .env.production and replace every placeholder before starting Compose.
# DATABASE_URL must point to a managed/reachable Postgres instance; production
# Compose deliberately does not run a database container.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/sprintify?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=https://app.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Sprintify
TURNSTILE_SECRET_KEY=replace-with-your-cloudflare-turnstile-secret
# This public key is compiled into the browser bundle during `docker compose build`.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-your-cloudflare-turnstile-site-key
STORAGE_BACKEND=s3
STORAGE_S3_BUCKET=replace-me
STORAGE_S3_REGION=replace-me
STORAGE_S3_ACCESS_KEY_ID=replace-me
STORAGE_S3_SECRET_ACCESS_KEY=replace-me
# Optional for an S3-compatible provider such as R2 or MinIO.
# STORAGE_S3_ENDPOINT=https://s3.example.com
