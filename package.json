{
  "name": "sprintify",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=3072' next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "email": "email dev --dir src/emails",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:deploy": "node scripts/migrate.mjs",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "admin:seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed-admin.ts",
    "db:clean": "tsx --env-file=.env.local scripts/clean-db.ts",
    "db:seed:demo": "tsx --conditions=react-server --env-file=.env.local scripts/seed-demo.ts",
    "embeddings:backfill": "tsx --conditions=react-server --env-file=.env.local scripts/backfill-embeddings.ts"
  },
  "dependencies": {
