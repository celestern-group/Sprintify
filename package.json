    "@sentry/nextjs": "^10.69.0",
    "@shadcn/react": "^0.2.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-table": "^8.21.3",
